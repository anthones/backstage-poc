FROM python:3.12-slim
WORKDIR /workspace
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY services/tenant-service/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY integrations/jira ./integrations/jira
COPY services ./services
COPY frontend/customer-portal/catalog-info.yaml ./frontend/customer-portal/catalog-info.yaml
USER 10001:10001
# main.py's own entry point binds loopback; Uvicorn must bind the container NIC.
CMD ["python", "-m", "uvicorn", "integrations.jira.main:app", "--host", "0.0.0.0", "--port", "8090"]
